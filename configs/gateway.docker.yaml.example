server:
  listen: ":8080"
  allow_private_targets: false

admin:
  # Docker 内监听所有地址，由 docker-compose 仅映射到宿主机 127.0.0.1:19090。
  listen: ":9090"
  password: ""
  jwt_secret: ""
  jwt_expire: "24h"
  login_max_failures: 5
  login_window: "60s"
  login_lockout: "5m"

health_check:
  interval: "30s"
  timeout: "5s"
  url: "https://www.google.com/generate_204"
  max_fail: 3

proxy:
  response_header_timeout: "3s"
  total_timeout: "30s"
  max_attempts: 5
  max_redirects: 5
  template_fallback_after_attempts: true

traffic:
  persistence:
    enabled: true
    retention_days: 7
  failure_grouping:
    enabled: true
    url_normalization:
      enabled: true
      rules: []
  success_folding:
    enabled: true
    rules: []

log:
  level: "info"
  file: ""
